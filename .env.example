# Copy to .env. Defaults match docker-compose.yml and are for local use only.
ANTHROPIC_API_KEY=

ASQL_DB_HOST=localhost
ASQL_DB_PORT=5433
ASQL_ADMIN_PASSWORD=admin-local-only
ASQL_READER_PASSWORD=reader-local-only
ASQL_APP_PASSWORD=app-local-only

ASQL_MODEL=claude-opus-5-5
ASQL_EFFORT=medium
ASQL_MAX_ROWS=500
ASQL_STATEMENT_TIMEOUT_MS=5000
ASQL_MAX_REPAIR_ATTEMPTS=1
